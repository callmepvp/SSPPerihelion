[locale]

translations=PoolStringArray(  )
locale_filter=[ 0, [ "en", "ja" ] ]

[logging]

file_logging/max_log_files=1

[mono]

project/assembly_name="Rhythia"

[physics]

common/physics_fps=120
common/enable_pause_aware_picking=true

[rendering]

quality/driver/fallback_to_gles2=true
threads/thread_model=2
vram_compression/import_etc=true
quality/directional_shadow/size=1024
quality/shadow_atlas/size=2048
quality/shadows/filter_mode=0
quality/reflections/texture_array_reflections=false
quality/filters/anisotropic_filter_level=2
2d/options/use_software_skinning=false
quality/lightmapping/use_bicubic_sampling=false
environment/default_clear_color=Color( 0, 0, 0, 1 )
quality/filters/msaa=1
environment/default_environment="res://default_env.tres"
